{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://events.mycompany.com/ticket-created-v1.json",
  "title": "TicketCreatedEvent",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAtUtc",
    "data"
  ],

  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique ID for this event instance"
    },

    "eventType": {
      "type": "string",
      "const": "ticket.created.v1",
      "description": "Event type version"
    },

    "occurredAtUtc": {
      "type": "string",
      "format": "date-time",
      "description": "When the event occurred"
    },

    "data": {
      "type": "object",
      "required": [
        "ticketId",
        "customerId",
        "subject",
        "description",
        "category",
        "priority",
        "channel",
        "status",
        "createdBy",
        "createdAtUtc"
      ],

      "properties": {
        "ticketId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string" },

        "subject": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },

        "category": {
          "type": "string",
          "enum": ["General", "Billing", "Technical", "Feedback"]
        },

        "priority": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"]
        },

        "channel": {
          "type": "string",
          "enum": ["Email", "Web", "Phone", "Chat"]
        },

        "status": {
          "type": "string",
          "enum": ["Open", "InProgress", "Resolved", "Closed"]
        },

        "assignedTechnicianId": {
          "type": ["string", "null"]
        },

        "createdBy": { "type": "string" },
        "createdAtUtc": { "type": "string", "format": "date-time" },

        "updatedBy": { "type": ["string", "null"] },
        "lastUpdatedAtUtc": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
