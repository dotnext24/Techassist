{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyForJwtTokenGeneration123!",
    "Issuer": "TechAssistPro",
    "Audience": "TechAssistProClients",
    "ExpirationMinutes": 60
  },
  "ReverseProxy": {
    "Routes": {
      "ticketing-route": {
        "ClusterId": "ticketing-cluster",
        "Match": {
          "Path": "/api/tickets/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Gateway-Timestamp",
            "Set": "{DateTime.UtcNow}"
          }
        ]
      },
      "scheduling-route": {
        "ClusterId": "scheduling-cluster",
        "Match": {
          "Path": "/api/scheduling/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Gateway-Timestamp",
            "Set": "{DateTime.UtcNow}"
          }
        ]
      },
      "custome-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Gateway-Timestamp",
            "Set": "{DateTime.UtcNow}"
          }
        ]
      },
      "ticketing-swagger": {
        "Match": {
          "Path": "/ticketing/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/ticketing"
          }
        ],
        "ClusterId": "ticketing-cluster"
      },
      "scheduling-swagger": {
        "Match": {
          "Path": "/scheduling/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/scheduling"
          }
        ],
        "ClusterId": "scheduling-cluster"
      },
      "customer-swagger": {
        "Match": {
          "Path": "/customer/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/customer"
          }
        ],
        "ClusterId": "customer-cluster"
      },
      "health-route": {
        "ClusterId": "health-cluster",
        "Match": {
          "Path": "/health/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ticketing-cluster": {
        "Destinations": {
          "ticketing": {
            "Address": "http://localhost:5001"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        },
        "Swagger": {
          "Enabled": true,
          "Path": "/swagger/v1/swagger.json"
        }
      },
      "scheduling-cluster": {
        "Destinations": {
          "scheduling": {
            "Address": "http://localhost:5002"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        },
        "Swagger": {
          "Enabled": true,
          "Path": "/swagger/v1/swagger.json"
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer": {
            "Address": "http://localhost:5003"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        },
        "Swagger": {
          "Enabled": true,
          "Path": "/swagger/v1/swagger.json"
        }
      },
      "health-cluster": {
        "Destinations": {
          "health-local": {
            "Address": "http://localhost:5000"
          }
        },
        "Swagger": {
          "Enabled": true,
          "Path": "/swagger/v1/swagger.json"
        }
      }
    }
  }
}